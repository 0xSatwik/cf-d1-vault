{
  "name": "cf-d1-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Scoped D1 credential vault and stateless Worker MCP gateway",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "wrangler dev --local",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.163.0"
  }
}
